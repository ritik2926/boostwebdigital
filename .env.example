# Resend API key — used by src/app/api/contact/route.ts and
# src/app/api/newsletter/subscribe/route.ts to send email. Get one at
# https://resend.com (free tier is enough to start). Without this set, the
# contact form fails loudly with a 503; the newsletter route logs and skips
# sending rather than failing the signup itself.
RESEND_API_KEY=

# Neon Postgres connection string — used ONLY by src/lib/db.ts, which may
# only be imported from files under src/app/api/ (and scripts/checker-test.mjs,
# which doesn't actually write). Backs the newsletter subscribers/sent_posts
# tables and the AI Visibility Checker's reports/usage_counters tables (see
# src/app/api/checker/run/route.ts for the real, live-verified schema — this
# route does not create or alter tables). Get one from your Neon project's
# dashboard.
DATABASE_URL=

# Inbox that contact-form submissions are sent to. Optional — falls back to
# ritik@boostwebdigital.com if unset (contact@ is an unverified alias —
# see src/app/api/contact/route.ts).
CONTACT_TO_EMAIL=

# Upstash Redis (REST API) — backs src/lib/rate-limit.ts's generic
# checkRateLimit(), used by both the contact form (3 submissions/IP/hour)
# and newsletter signups (3/IP/hour) via @upstash/ratelimit + @upstash/redis.
# Get both values from https://console.upstash.com (free tier is enough).
# Optional — if unset, or if Upstash is unreachable, rate limiting fails
# OPEN (never blocks a real submission), and a warning is logged instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Exa API key — used by src/lib/checker/engines/exa.ts and
# src/lib/checker/analyse.ts (both calls in the AI Visibility Checker; Exa
# is the default engine as of 2026-09-01). Get one at https://dashboard.exa.ai
# (free tier: $10/month credit, no payment method required; /answer costs
# $5 per 1,000 requests). Without this set, checker requests fail with a
# clear error; nothing else on the site depends on it.
EXA_API_KEY=

# Google AI Studio API key — used by src/lib/checker/engines/gemini.ts,
# which is registered but NOT the active engine (see that file's header
# comment: Gemini 2.5 now 404s for new API keys, and grounding on any 3.x
# model requires billing). Kept so Gemini becomes usable again with a
# one-line change in engines/index.ts if billing is ever enabled. Optional —
# nothing currently calls it.
GEMINI_API_KEY=

# "free" or "paid" — selects the model pair in src/lib/checker/config.ts,
# read by the currently-unused Gemini engine only. Optional, defaults to
# "free" if unset or anything other than "paid".
GEMINI_TIER=

# HMAC secret used to sign the checker's visitor_id cookie (src/lib/checker/
# visitor.ts) — proves the cookie wasn't tampered with client-side to reset
# the 2-free-reports-per-visitor limit. Generate with, e.g.,
# `openssl rand -hex 32`. Optional but recommended — without it the cookie
# ships unsigned, which makes the limit trivially bypassable.
VISITOR_COOKIE_SECRET=

# Salt mixed into the SHA-256 hash of a visitor's IP address before it's
# stored (src/lib/checker/visitor.ts) — the raw IP itself is never written
# to the database. Generate with, e.g., `openssl rand -hex 32`. Optional,
# but set it — without a salt the hash is still one-way, just easier to
# attack via a precomputed table of common IPs.
IP_HASH_SALT=

# Google Apps Script Web App URL that mirrors each completed checker report
# to a Google Sheet (src/lib/checker/leads.ts, SINK 3). Treat this as a
# secret, not just a URL — anyone holding it can write rows to that sheet.
# Optional — if unset (or SHEET_WEBHOOK_SECRET below is), the Sheet mirror
# is skipped silently with one log line, never an error.
SHEET_WEBHOOK_URL=

# Shared secret sent in the body of every request to SHEET_WEBHOOK_URL above
# so the Apps Script endpoint can reject requests that don't know it.
# Generate with, e.g., `openssl rand -hex 32`. Optional, see SHEET_WEBHOOK_URL.
SHEET_WEBHOOK_SECRET=
