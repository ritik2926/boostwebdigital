# Resend API key — used by src/app/api/contact/route.ts to send contact-form
# submissions by email. Get one at https://resend.com (free tier is enough
# to start). Without this set, the contact form fails loudly with a 503
# instead of pretending to send.
RESEND_API_KEY=

# Inbox that contact-form submissions are sent to. Optional — falls back to
# contact@boostwebdigital.com if unset.
CONTACT_TO_EMAIL=

# Upstash Redis (REST API) — backs src/lib/rate-limit.ts, used by the
# contact form (3 submissions/IP/hour) and reusable by future callers.
# Get both values from https://console.upstash.com (free tier is enough).
# Optional — if unset, or if Upstash is unreachable, rate limiting fails
# OPEN (never blocks a real submission), and a warning is logged instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
